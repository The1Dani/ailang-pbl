-> @Load {
    from "examples/train_features.csv" -> train_features
    from "examples/train_labels.csv" -> train_labels
    from "examples/test_features.csv"  -> test_features
} -> @Train {
    y := train_labels.Survived

    model <- svc.fit <- (train_features, y)

    predictions := model.predict <- (test_features)

    score := model.score <- (train_features, y)
    .print <- (score)
}
