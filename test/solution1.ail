// solution1.ail  -  Titanic survival (classification)

// Runs in the branch scope, so it sees that branch's model + X + y.
// Returns the model's accuracy as the validation score.
function validate <- (model) {
    return model.score <- (X, y)
}

// Receives every branch's scores + models; keep the highest scorer
// and report it together with its score.
function validate_select <- (scores_map) {
    scores <- scores_map.scores
    models <- scores_map.models
    best   <- .select_best <- (scores, models)

    n <- scores.len <- ()
    i <- 1
    best_score <- scores.at <- (0)
    while { i < n } do {
        current <- scores.at <- (i)
        do {
            best_score <- current
        } if {
            current > best_score
        }
        i <- i + 1
    }

    .print <- ("Best model:", best, "with score:", best_score)
}

-> @Load {
    get "https://www.kaggle.com/datasets/yasserh/titanic-dataset" "Titanic-Dataset.csv"
    from "Titanic-Dataset.csv" -> train_raw
} -> @Prepare {
    train_num <- train_raw.select_numeric <- ()
    train_num <- train_num.fillna_median  <- ()
    y         := train_raw.Survived
}

@Prepare -> @BranchA {
    X     <- train_num.select_cols <- (("Pclass", "Fare"))
    model <- logistic_regression.fit <- (X, y)
} -> @Validate(model)

@Prepare -> @BranchB {
    X     <- train_num.select_cols <- (("Pclass", "Age", "SibSp", "Parch", "Fare"))
    model <- random_forest_classifier.fit <- (X, y)
} -> @Validate(model)

@Prepare -> @BranchC {
    X     <- train_num.select_cols <- (("Age", "Fare", "Pclass"))
    model <- knn_classifier.fit <- (X, y)
} -> @Validate(model)
