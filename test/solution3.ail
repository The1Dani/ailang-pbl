// solution3.ail  -  Spaceship Titanic (classification)

// Score a model with 5-fold cross-validated accuracy.
function validate <- (model) {
    result <- model.cross_validate <- (X, y, 5, "accuracy")
    return result.mean_score
}

// Receive every branch's score+model, keep the best, ship it.
function validate_select <- (scores_map) {
    scores <- scores_map.scores
    models <- scores_map.models

    n <- scores.len <- ()
    i <- 1
    best_score <- scores.at <- (0)
    best_model <- models.at <- (0)

    while { i < n } do {
        current_score <- scores.at <- (i)
        current_model <- models.at <- (i)
        do {
            best_score <- current_score
            best_model <- current_model
        } if {
            current_score > best_score
        }
        i <- i + 1
    }

    best_model.save_model <- ("test/data/spaceship_best_model.joblib")
    predictions <- best_model.predict <- (X_test)
    .save_csv <- (predictions, "test/data/spaceship_submission.csv", ids=test_ids)
    .print    <- ("best model:", best_model)
}

-> @Load {
    get "https://www.kaggle.com/datasets/defcodeking/spaceship-titanic-prepared-datasets" "train_prepared.csv"
    get "https://www.kaggle.com/datasets/defcodeking/spaceship-titanic-prepared-datasets" "test_prepared.csv"
    from "train_prepared.csv" -> train_raw
    from "test_prepared.csv"  -> test_raw
} -> @Prepare {
    train_proc <- train_raw.map_bool_cols   <- (("Transported", "CryoSleep", "VIP"))
    train_num  <- train_proc.select_numeric <- ()
    train_num  <- train_num.fillna_median   <- ()

    test_proc <- test_raw.map_bool_cols   <- (("CryoSleep", "VIP"))
    test_num  <- test_proc.select_numeric <- ()
    test_num  <- test_num.fillna_median   <- ()
    X_test    <- test_num.select_cols     <- (("CryoSleep", "VIP", "Age", "RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"))

    y        := train_proc.Transported
    test_ids := test_raw.PassengerId
}

@Prepare -> @BranchA {
    X     <- train_num.select_cols <- (("CryoSleep", "Age", "Spa", "VRDeck"))
    model <- random_forest_classifier.fit <- (X, y)
} -> @Validate(model)

@Prepare -> @BranchB {
    X     <- train_num.select_cols <- (("CryoSleep", "VIP", "RoomService", "FoodCourt", "ShoppingMall"))
    model <- svc.fit <- (X, y)
} -> @Validate(model)

@Prepare -> @BranchC {
    X     <- train_num.select_cols <- (("CryoSleep", "VIP", "Age", "RoomService", "FoodCourt", "ShoppingMall", "Spa", "VRDeck"))
    model <- catboost_classifier.fit <- (X, y)
} -> @Validate(model)
